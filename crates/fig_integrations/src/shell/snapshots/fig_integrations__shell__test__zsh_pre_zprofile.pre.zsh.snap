---
source: crates/fig_integrations/src/shell/mod.rs
expression: integration.get_contents()
---
_SHELLCUE_LOCAL_BIN="$HOME/.local/bin"
[[ ":$PATH:" != *":$_SHELLCUE_LOCAL_BIN:"* ]] && PATH="${PATH:+"$PATH:"}$_SHELLCUE_LOCAL_BIN"
unset _SHELLCUE_LOCAL_BIN

command -v shellcue >/dev/null 2>&1 && eval "$(shellcue init zsh pre --rcfile zprofile)"
