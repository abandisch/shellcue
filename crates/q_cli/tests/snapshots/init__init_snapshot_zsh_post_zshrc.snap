---
source: q_cli/tests/init.rs
expression: init
---
SHELLCUE_SHELL="/bin/zsh"
if [[ -n "${ZSH_NAME:-}" ]]; then

# add ~/.local/bin to PATH
if [[ -d "${HOME}/.local/bin" ]] && [[ ":$PATH:" != *":${HOME}/.local/bin:"* ]]; then
  PATH="${PATH:+"$PATH:"}${HOME}/.local/bin"
fi

if [[ -z "${TTY:-}" ]]; then
  TTY=$(tty)
fi
export TTY

export SHELL_PID="$$"

if [[ -z "${SHELLCUE_SHELL:-}" ]]; then
  SHELLCUE_SHELL=$(shellcue _ get-shell)
fi

# shellcheck disable=SC2059
function shellcue_osc { printf "\033]697;$1\007" "${@:2}"; }

SHELLCUE_HAS_SET_PROMPT=0

shellcue_preexec() {
  # Restore user defined prompt before executing.
  if [ -n "${PS1+x}" ]; then
    PS1="$SHELLCUE_USER_PS1"
  fi
  if [ -n "${PROMPT+x}" ]; then
    PROMPT="$SHELLCUE_USER_PROMPT"
  fi
  if [ -n "${prompt+x}" ]; then
    prompt="$SHELLCUE_USER_prompt"
  fi

  if [ -n "${PS2+x}" ]; then
    PS2="$SHELLCUE_USER_PS2"
  fi
  if [ -n "${PROMPT2+x}" ]; then
    PROMPT2="$SHELLCUE_USER_PROMPT2"
  fi

  if [ -n "${PS3+x}" ]; then
    PS3="$SHELLCUE_USER_PS3"
  fi
  if [ -n "${PROMPT3+x}" ]; then
    PROMPT3="$SHELLCUE_USER_PROMPT3"
  fi

  if [ -n "${PS4+x}" ]; then
    PS4="$SHELLCUE_USER_PS4"
  fi
  if [ -n "${PROMPT4+x}" ]; then
    PROMPT4="$SHELLCUE_USER_PROMPT4"
  fi

  if [ -n "${RPS1+x}" ]; then
    RPS1="$SHELLCUE_USER_RPS1"
  fi
  if [ -n "${RPROMPT+x}" ]; then
    RPROMPT="$SHELLCUE_USER_RPROMPT"
  fi

  if [ -n "${RPS2+x}" ]; then
    RPS2="$SHELLCUE_USER_RPS2"
  fi
  if [ -n "${RPROMPT2+x}" ]; then
    RPROMPT2="$SHELLCUE_USER_RPROMPT2"
  fi

  SHELLCUE_HAS_SET_PROMPT=0

  shellcue_osc "OSCLock=%s" "${SHELLCUE_TERM_SESSION_ID}"
  shellcue_osc PreExec
}

shellcue_precmd() {
  local LAST_STATUS=$?

  shellcue_reset_hooks

  shellcue_osc "OSCUnlock=%s" "${SHELLCUE_TERM_SESSION_ID}"
  shellcue_osc "Dir=%s" "$PWD"
  shellcue_osc "Shell=zsh"
  shellcue_osc "ShellPath=%s" "${SHELLCUE_SHELL:-$SHELL}"
  shellcue_osc "PID=%d" "$$"
  shellcue_osc "ExitCode=%s" "${LAST_STATUS}"
  shellcue_osc "TTY=%s" "${TTY}"
  shellcue_osc "Log=%s" "${SHELLCUE_LOG_LEVEL}"
  shellcue_osc "ZshAutosuggestionColor=%s" "${ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE}"
  shellcue_osc "FigAutosuggestionColor=%s" "${SHELLCUE_AUTOSUGGEST_HIGHLIGHT_STYLE}"
  shellcue_osc "User=%s" "${USER:-root}"

  if [ "$SHELLCUE_HAS_SET_PROMPT" -eq 1 ]; then
    # ^C pressed while entering command, call preexec manually to clear ShellCue prompts.
    shellcue_preexec
  fi

  START_PROMPT=$'\033]697;StartPrompt\007'
  END_PROMPT=$'\033]697;EndPrompt\007'
  NEW_CMD=$'\033]697;NewCmd='"${SHELLCUE_TERM_SESSION_ID}"$'\007'

  # Save user defined prompts.
  SHELLCUE_USER_PS1="$PS1"
  SHELLCUE_USER_PROMPT="$PROMPT"
  SHELLCUE_USER_prompt="$prompt"

  SHELLCUE_USER_PS2="$PS2"
  SHELLCUE_USER_PROMPT2="$PROMPT2"

  SHELLCUE_USER_PS3="$PS3"
  SHELLCUE_USER_PROMPT3="$PROMPT3"

  SHELLCUE_USER_PS4="$PS4"
  SHELLCUE_USER_PROMPT4="$PROMPT4"

  SHELLCUE_USER_RPS1="$RPS1"
  SHELLCUE_USER_RPROMPT="$RPROMPT"

  SHELLCUE_USER_RPS2="$RPS2"
  SHELLCUE_USER_RPROMPT2="$RPROMPT2"

  if [ -n "${PROMPT+x}" ]; then
    PROMPT="%{$START_PROMPT%}$PROMPT%{$END_PROMPT$NEW_CMD%}"
  elif [ -n "${prompt+x}" ]; then
    prompt="%{$START_PROMPT%}$prompt%{$END_PROMPT$NEW_CMD%}"
  else
    PS1="%{$START_PROMPT%}$PS1%{$END_PROMPT$NEW_CMD%}"
  fi

  if [ -n "${PROMPT2+x}" ]; then
    PROMPT2="%{$START_PROMPT%}$PROMPT2%{$END_PROMPT%}"
  else
    PS2="%{$START_PROMPT%}$PS2%{$END_PROMPT%}"
  fi

  if [ -n "${PROMPT3+x}" ]; then
    PROMPT3="%{$START_PROMPT%}$PROMPT3%{$END_PROMPT$NEW_CMD%}"
  else
    PS3="%{$START_PROMPT%}$PS3%{$END_PROMPT$NEW_CMD%}"
  fi

  if [ -n "${PROMPT4+x}" ]; then
    PROMPT4="%{$START_PROMPT%}$PROMPT4%{$END_PROMPT%}"
  else
    PS4="%{$START_PROMPT%}$PS4%{$END_PROMPT%}"
  fi

  # Previously, the af-magic theme added a final % to expand. We need to paste without the %
  # to avoid doubling up and mangling the prompt. I've removed this workaround for now.
  if [ -n "${RPROMPT+x}" ]; then
    RPROMPT="%{$START_PROMPT%}$RPROMPT%{$END_PROMPT%}"
  else
    RPS1="%{$START_PROMPT%}$RPS1%{$END_PROMPT%}"
  fi

  if [ -n "${RPROMPT2+x}" ]; then
    RPROMPT2="%{$START_PROMPT%}$RPROMPT2%{$END_PROMPT%}"
  else
    RPS2="%{$START_PROMPT%}$RPS2%{$END_PROMPT%}"
  fi

  SHELLCUE_HAS_SET_PROMPT=1

  if command -v shellcue >/dev/null 2>&1; then
    (command shellcue _ pre-cmd --alias "$(\alias)" > /dev/null 2>&1 &) >/dev/null 2>&1
  fi
}

shellcue_reset_hooks() {
  # shellcheck disable=SC1087,SC2193
  if [[ "$precmd_functions[-1]" != shellcue_precmd ]]; then
    # shellcheck disable=SC2206,SC2296
    precmd_functions=(${(@)precmd_functions:#shellcue_precmd} shellcue_precmd)
  fi
  # shellcheck disable=SC1087,SC2193
  if [[ "$preexec_functions[1]" != shellcue_preexec ]]; then
    # shellcheck disable=SC2206,SC2296
    preexec_functions=(shellcue_preexec ${(@)preexec_functions:#shellcue_preexec})
  fi
}

shellcue_reset_hooks
if [[ -n "${PROCESS_LAUNCHED_BY_SHELLCUE:-}" ]]; then
  shellcue_osc DoneSourcing
fi

fi

(command shellcue _ pre-cmd --alias "$(\alias)" > /dev/null 2>&1 &) >/dev/null 2>&1
